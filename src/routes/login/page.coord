<main class="auth-page">
  <section class="auth-story"><a href="/" class="brand"><img class="brand-logo" src="/coordiation-logo.png" alt="Coordiation" width="36" height="36"><span>coordiation</span></a><div><span class="eyebrow">YOUR IDEAS. YOUR SPACE.</span><h1>Your stories.<br>Your site.<br>Entirely your own.</h1><p>One space to write, create, and build something meaningful.</p></div><small>Coordiation CMS · Built with Coordiation Fullstack</small></section>
  <section class="auth-panel"><div class="auth-card">
    {#if needsSetup}<span class="eyebrow">WELCOME</span><h2>Your new workspace.</h2><p>Set up your site and your first administrator account.</p>{:else}<span class="eyebrow">WORKSPACE</span><h2>Welcome back.</h2><p>Sign in to pick up where you left off.</p>{/if}
    <form id="auth-form" data-setup="{needsSetup}">
      {#if needsSetup}<label>Full name<input name="name" autocomplete="name" required placeholder="Your name"></label><label>Site title<input name="title" required value="Studio Journal"></label><label>Setup token<input name="token" type="password" autocomplete="off" placeholder="Token from your server administrator"></label>{/if}
      <label>Email address<input name="email" type="email" autocomplete="username" required placeholder="you@example.com"></label><label>Password<input name="password" type="password" autocomplete="current-password" minlength="15" maxlength="256" required placeholder="At least 15 characters"></label>
      {#if needsSetup}<label class="check-label"><input name="demo" type="checkbox" checked>Add sample content to get started</label>{/if}
      <p id="auth-error" class="form-error" role="alert" hidden></p><button class="button primary full" type="submit">{#if needsSetup}Create my site <span class="icon co-icon co-icon-arrow" aria-hidden="true"></span>{:else}Sign in to workspace <span class="icon co-icon co-icon-arrow" aria-hidden="true"></span>{/if}</button>
    </form><a class="back-link" href="/"><span class="icon co-icon co-icon-back" aria-hidden="true"></span> Back to site</a>
  </div></section>
</main>
