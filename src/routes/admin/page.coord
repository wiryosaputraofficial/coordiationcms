<div class="cms-shell">
  <aside class="sidebar" id="sidebar">
    <a href="/admin" class="brand"><img class="brand-logo" src="/coordiation-logo.png" alt="Coordiation" width="36" height="36"><span>coordiation<span class="brand-sub">CONTENT MANAGEMENT</span></span></a>
    <a class="site-switch" href="/" target="_blank" rel="noopener"><span class="site-avatar">S</span><span><strong id="sidebar-title">Your site</strong><small>View public site ↗</small></span></a>
    <nav id="navigation" aria-label="CMS navigation"></nav>
    <div class="sidebar-bottom"><span class="engine-dot"></span> Powered by Coordiation <span class="version">0.1</span></div>
  </aside>
  <div class="main-shell">
    <header class="topbar"><div class="breadcrumb"><button class="icon-button mobile-toggle" id="mobile-toggle" aria-label="Open navigation"><span class="icon co-icon co-icon-menu" aria-hidden="true"></span></button><span>Workspace</span><span class="slash">/</span><strong id="breadcrumb">Dashboard</strong></div><div class="top-actions"><a href="/" target="_blank" rel="noopener" class="site-link">View site ↗</a><span class="top-divider"></span><button class="profile-button" id="profile-button"><span class="avatar" id="user-initial">W</span><span id="user-name">{user.name}</span><span class="icon co-icon co-icon-down chevron" aria-hidden="true"></span></button></div></header>
    <main id="workspace" class="workspace"><p class="loading">Preparing your workspace…</p></main>
    <footer class="admin-footer"><span>A space for ideas that matter.</span><span>Coordiation CMS · 0.1.0</span></footer>
  </div>
</div>
<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
<dialog id="modal" class="modal"><div id="modal-content"></div></dialog>
