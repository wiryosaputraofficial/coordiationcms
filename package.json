{
  "name": "coordiation-cms",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/build-statistics-chart.js && node scripts/build-public-components.js && coordiation-app dev --host 127.0.0.1 --port 3118",
    "build": "node scripts/build-statistics-chart.js && node scripts/build-public-components.js && coordiation-app build",
    "start": "coordiation-app start --host 127.0.0.1 --port 3118",
    "test": "node --test tests/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@coordiation/cli": "1.0.0-rc.2",
    "@coordiation/css": "1.0.0-rc.1",
    "@coordiation/fullstack": "0.1.0-alpha.1",
    "echarts": "6.1.0",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "handlebars": "4.7.9",
    "rolldown": "1.2.6",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "description": "Self-hosted publishing CMS built with Coordiation Fullstack, with native themes, SEO controls, and AI writing assistance.",
  "homepage": "https://coordiation.com/cms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiryosaputraofficial/coordiationcms.git"
  },
  "bugs": {
    "url": "https://github.com/wiryosaputraofficial/coordiationcms/issues"
  },
  "author": "Wiryo Saputra",
  "keywords": [
    "cms",
    "coordiation",
    "publishing",
    "blog",
    "themes",
    "seo"
  ],
  "bin": {
    "coordiation-cms": "bin/coordiation-cms.js"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "scripts/backup.js",
    "scripts/build-public-components.js",
    "scripts/export-themes.js",
    "scripts/reset-password.js",
    "scripts/restore.js",
    "scripts/start-production.js",
    "coordiation.config.json",
    "Dockerfile",
    "compose.yaml",
    ".dockerignore",
    ".env.example",
    "docs/DEPLOYMENT.md",
    "docs/DESIGN-SYSTEM.md",
    "docs/FEATURES.md",
    "docs/SECURITY.md",
    "docs/SEO-AND-AI.md",
    "docs/THEMES.md",
    "docs/ICON-MANIFEST.json",
    "LICENSE",
    "scripts/build-statistics-chart.js",
    "scripts/statistics-chart-entry.js",
    "CHANGELOG.md",
    "docs/PAGE-BUILDER.md",
    "scripts/builder-styles.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "license": "MIT"
}
